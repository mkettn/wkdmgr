{
  "openapi": "3.1.0",
  "info": {
    "title": "wkdmgr-mgmt",
    "description": "",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/keys": {
      "get": {
        "tags": [],
        "summary": "List the authenticated uid's own published keys",
        "operationId": "list_keys",
        "responses": {
          "200": {
            "description": "Keys owned by the authenticated uid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KeyResponseItem"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing SSO identity header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "summary": "Publish a minimized key for one of the authenticated uid's addresses",
        "operationId": "upload_key",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyResponseItem"
                }
              }
            }
          },
          "400": {
            "description": "parse_failed | no_matching_uid | address_not_owned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing SSO identity header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "already_exists -- delete the existing key first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "UserDb backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/keys/{id}": {
      "delete": {
        "tags": [],
        "summary": "Revoke (delete) one of the authenticated uid's own published keys",
        "operationId": "delete_key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The key's database row id, from GET /api/keys",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "Missing SSO identity header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not owned by the authenticated uid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [],
        "summary": "Get the authenticated uid and the addresses it's authorized to manage",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "The authenticated uid and its owned addresses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing SSO identity header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "UserDb backend unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorBody": {
        "type": "object",
        "description": "The JSON body every non-2xx response carries. Exists purely for the\ngenerated OpenAPI schema -- `ApiError::into_response` builds this\nshape ad hoc via `serde_json::json!` rather than constructing one of\nthese, so keep the two in sync by hand if either changes.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A fixed, machine-matchable error code (e.g. `parse_failed`,\n`address_not_owned`, `already_exists`, `no_matching_uid`,\n`not_found`)."
          },
          "message": {
            "type": "string",
            "description": "A human-readable explanation, safe to display to the user."
          }
        }
      },
      "KeyResponseItem": {
        "type": "object",
        "required": [
          "id",
          "address",
          "domain",
          "fingerprint",
          "uploaded_at",
          "revoked"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          },
          "uploaded_at": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "uid",
          "addresses"
        ],
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uid": {
            "type": "string"
          }
        }
      },
      "UploadRequest": {
        "type": "object",
        "required": [
          "address",
          "key"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "description": "ASCII-armored or base64-encoded OpenPGP public key material."
          }
        }
      }
    }
  }
}
